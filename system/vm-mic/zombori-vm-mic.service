[Unit]
Description=Mac microphone (vm/mic.sh) into the Loopback sound card, for the gate in the VM
Documentation=file:///mnt/zombori/docs/03-gate.md
After=network.target sound.target systemd-modules-load.service
# Before the gate listens, so the stream has somewhere to go as early as possible.
Before=zombori-gate.service

[Service]
# Receive the raw 16 kHz mono audio vm/mic.sh sends as UDP packets to port 4713 (from any sender,
# so restarting vm/mic.sh needs nothing here) and play it into the Loopback card. Without
# packets, the Loopback card just records silence. A small buffer (0.1 s) keeps the delay short,
# so the question's echo from the speakers arrives while the gate still ignores it.
ExecStart=/bin/sh -c 'socat -u UDP-RECV:4713 STDOUT | aplay -q -D plughw:5,0 -t raw -f S16_LE -r 16000 -c 1 --buffer-time=100000'
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
